            "field": "engine"
          }
        }
      ],
      "steps": [
        {
          "tool": "dse.daily",
          "label": "Build the next send list",
          "values": {
            "engine": "{{engine}}"
          }
        },
        {
          "tool": "dse.followups",
          "label": "Plan the follow-ups",
          "values": {
            "engine": "{{engine}}"
          }
        }
      ]
    }
  },
