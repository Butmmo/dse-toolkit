    "dse.podcasts": {
      "label": "Podcast leads (Broadcast Engine)",
      "group": "Find clients",
      "help": "Active business podcasts from Apple Podcasts' free search, with what each show is missing (gaps between episodes, no video, thin show notes) and the host's public email when the feed lists it.",
      "script": "dse.py",
      "args": [
        {
          "lit": "podcasts"
        },
        {
          "field": "terms"
        },
        {
          "opt": "--genre",
          "field": "genre"
        },
        {
          "opt": "--max",
          "field": "max"
        }
      ],
      "fields": [
        {
          "name": "terms",
          "label": "Topics",
          "type": "text",
          "required": true,
          "max": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ;,&'-]{1,199}$",
          "placeholder": "marketing; startup; sales"
        },
        {
          "name": "genre",
          "label": "Genre",
          "type": "choice",
          "default": "business",
          "choices": [
            {
              "value": "business",
              "label": "Business"
            },
            {
              "value": "entrepreneurship",
              "label": "Entrepreneurship"
            },
            {
              "value": "marketing",
              "label": "Marketing"
            },
            {
              "value": "management",
              "label": "Management"
            },
