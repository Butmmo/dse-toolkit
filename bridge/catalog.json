          "field": "currency"
        },
        {
          "flag": "--ai",
          "field": "ai"
        },
        {
          "flag": "--install",
          "field": "install"
        }
      ],
      "fields": [
        {
          "name": "kind",
          "label": "What to build",
          "type": "choice",
          "required": true,
          "choices": [
            {
              "value": "website",
              "label": "Website (plain, fast, host free)"
            },
            {
              "value": "webapp",
              "label": "Web app (installs on phones, works offline)"
            },
            {
              "value": "mobile",
              "label": "Phone app (iPhone + Android)"
            },
            {
              "value": "desktop",
              "label": "Desktop app (Windows/Mac/Linux)"
            },
            {
              "value": "tv",
