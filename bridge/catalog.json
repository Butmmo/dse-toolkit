    "dse.mystery_new": {
      "label": "CareBridge: start a mystery-shop tracker",
      "group": "CareBridge",
      "help": "Turns a home-care lead list into a tracker. You send each enquiry yourself, then fill in when you sent it and when they replied.",
      "script": "dse.py",
      "args": [
