    "dse.build": {
      "label": "Download business data (once per type)",
      "group": "Setup",
      "help": "Downloads one or more business types from Foursquare's free open data (needs your free Hugging Face token set on the PC; README). Do it once, then monthly.",
      "script": "dse.py",
      "args": [
        {
          "lit": "build"
        },
        {
          "field": "kinds"
        }
      ],
      "fields": [
        {
          "name": "kinds",
          "label": "Business types (comma-separated)",
          "type": "text",
          "required": true,
          "max": 300,
          "pattern": "^[a-z-]+(,[a-z-]+)*$",
          "placeholder": "dentist,plumber"
        }
      ],
      "timeout_min": 90,
      "outputs": []
    },
    "howto.ask": {
      "label": "How to do it (your path's tools)",
      "group": "Guides",
      "help": "Step-by-step recipes written from the tools' official help pages: Clay, Apollo, HubSpot, Sales Navigator, Instantly, Lemlist, n8n, Vapi, Cal.com, GoHighLevel, Klaviyo, Descript, CapCut, LinkedIn posts, sales calls and the whole GTM system. Each recipe gives the goal, what to have ready, steps with why each matters and what you should see, mistakes to avoid, a 'you are done when' check, the official source links and the date it was checked. Ask in your own words, like: enrich my list with emails in clay. Menus and plans change: if a button differs, open the source link in the answer.",
      "script": "howto/howto.py",
      "args": [
        {
          "field": "question"
        }
      ],
      "fields": [
        {
          "name": "question",
          "label": "What do you want to do?",
          "type": "text",
          "required": true,
          "max": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'?&/()-]{2,199}$",
          "placeholder": "abandoned cart flow in klaviyo"
        }
      ],
      "timeout_min": 1,
      "outputs": []
    },
    "chat.ask": {
      "label": "HQ chat: ask anything",
      "group": "Guides",
      "help": "Ask anything about selling, discovery calls, objections, cold messages, follow-ups, pricing and proposals, freelancing, international clients, planning, focus, decisions, rejection, writing, or any tool in the stack. Answers are grounded in HQ's researched guides and recipes. Three levels, best available is used: (1) Claude, the strongest: set your own Claude API key as the Windows user variable ANTHROPIC_API_KEY, run pip install anthropic, and restart the runner (your question and the matching guide text go to Anthropic, you pay your own usage; nothing else is sent unless you ask about your progress). (2) Free local AI with Ollama: install it from ollama.com, run ollama pull gemma3:4b (about 3.3 GB, needs about 8 GB RAM, also reads pictures), set OLLAMA_MODEL=gemma3:4b and restart the runner. gemma3:1b works on small PCs but gives thinner answers. (3) With neither, you get the matching researched guide or recipe in full. The answer says which one wrote it. To ask about a picture in Citadel, use DBI-AI with an image-capable model.",
      "script": "chat/chat.py",
      "args": [
        {
          "field": "question"
        },
        {
          "opt": "--image",
          "field": "image"
        },
        {
          "opt": "--engine",
          "field": "engine"
        },
        {
          "opt": "--image-id",
          "field": "image_id"
        }
      ],
      "fields": [
        {
          "name": "question",
          "label": "Your question (up to 2000 characters)",
          "type": "text",
          "required": true,
          "max": 2000,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'?&/()!:;\\\"%+=#@_*$-]{2,1999}$",
          "placeholder": "a client says it is too expensive"
        },
        {
          "name": "image",
          "label": "Picture (optional)",
          "type": "file",
          "glob": "chat/images/*.*",
          "exclude": "\\.keep$"
        },
        {
          "name": "engine",
          "label": "Engine folder (optional)",
          "type": "text",
          "required": false,
          "max": 60,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,59}$",
          "placeholder": "engine-b-reviews"
        },
        {
          "name": "image_id",
          "label": "Picture from Citadel (internal)",
          "type": "text",
          "required": false,
          "max": 36,
          "pattern": "^[0-9a-f-]{36}$"
        }
      ],
      "timeout_min": 10,
      "outputs": []
    },
    "app.build": {
      "label": "App Builder: build any website or app",
      "group": "Build",
      "help": "Builds a real, working project for you: a website, web app (installs on phones), native phone app (iPhone + Android), desktop app (Windows/Mac) or TV app (Samsung, LG, Android TV). Pick a starting point (landing page, dashboard, store, booking), your name, colour and one line about it. You get a folder in builds/ with the app, a README with the exact commands to run and publish it, a BUILD-BRIEF of what to build next, and rules so an AI coding agent can carry on. Needs Node.js LTS (nodejs.org) for everything except the plain website. Tick 'Install and test the build' to have it prove the app builds (a few minutes). Nothing is published or paid for: you deploy yourself.",
      "script": "builder/build.py",
      "args": [
        {
          "lit": "new"
        },
        {
          "opt": "--kind",
          "field": "kind"
        },
        {
          "opt": "--name",
          "field": "name"
        },
        {
          "opt": "--blueprint",
          "field": "blueprint"
        },
        {
          "opt": "--color",
          "field": "color"
