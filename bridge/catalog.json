    "dse.mystery_score": {
      "label": "CareBridge: score agencies by reply time",
      "group": "CareBridge",
      "help": "Hot = no reply after 48 h or a reply after 24 h+; Warm = 1-24 h; Cold = within the hour. Reach out to Hot and Warm only.",
      "script": "dse.py",
      "args": [
        {
          "lit": "mystery"
        },
        {
          "lit": "score"
