        },
        {
          "name": "max",
          "label": "How many shows",
          "type": "int",
          "min": 5,
          "max": 150,
          "default": 60
        }
      ],
      "timeout_min": 30,
      "outputs": [
        {
          "glob": "my-lists/*.csv",
          "upload": true
        }
      ]
    },
