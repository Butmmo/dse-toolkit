    "dse.build": {
      "label": "Download business data (once per type)",
      "group": "Setup",
      "help": "Downloads one or more business types from Foursquare's free open data (needs your free Hugging Face token set on the PC; README). Do it once, then monthly.",
      "script": "dse.py",
      "args": [
        {
          "lit": "build"
        },
        {
          "field": "kinds"
        }
      ],
      "fields": [
        {
          "name": "kinds",
          "label": "Business types (comma-separated)",
          "type": "text",
          "required": true,
          "max": 300,
          "pattern": "^[a-z-]+(,[a-z-]+)*$",
          "placeholder": "dentist,plumber"
        }
      ],
      "timeout_min": 90,
      "outputs": []
    },
    "howto.ask": {
      "label": "How to do it (your path's tools)",
      "group": "Guides",
      "help": "Type what you want to do and get the steps. Covers all 8 paths: GoHighLevel (SMB), Klaviyo (Revenue Recovery), Descript and CapCut (Broadcast), LinkedIn (Authority), Vapi and Cal.com (Voice AI), n8n (AI Automation), sales calls (Ascent), and Clay, HubSpot, Sales Navigator, Apollo, Instantly, Lemlist (GTM).",
      "script": "howto/howto.py",
      "args": [
        {
          "field": "question"
        }
      ],
      "fields": [
        {
          "name": "question",
          "label": "What do you want to do?",
          "type": "text",
          "required": true,
          "max": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'?&/()-]{2,199}$",
          "placeholder": "abandoned cart flow in klaviyo"
        }
      ],
      "timeout_min": 1,
      "outputs": []
    },
    "chat.ask": {
      "label": "HQ chat: ask anything",
      "group": "Guides",
      "help": "Ask about selling, objections, freelancing, planning, simple thinking or any tool. Free full AI chat with Ollama (runs on your PC, no paid AI): 1) Install Ollama from ollama.com (Windows installer). 2) In a terminal run: ollama pull gemma3:1b (about 0.8 GB, text only, works on most PCs). 3) Optional, 8 GB+ RAM: ollama pull gemma3:4b (about 3.3 GB, also reads images), set the Windows user variable OLLAMA_MODEL=gemma3:4b and restart the runner. 4) Keep Ollama running (it starts with Windows). Without Ollama you get the built-in answers. Images: in a terminal, chat.py \"what is this\" --image photo.png. Video and PDF are not supported by these light models.",
      "script": "chat/chat.py",
      "args": [
        {
          "field": "question"
        }
      ],
      "fields": [
        {
          "name": "question",
          "label": "Your question",
          "type": "text",
          "required": true,
          "max": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'?&/()!-]{2,199}$",
          "placeholder": "a client says it is too expensive"
        }
      ],
      "timeout_min": 6,
      "outputs": []
    }
