{
  "name": "my-provider",
  "label": "Any email-by-domain API you have a key for",
  "about": "Copy this file to enrich-providers/my-provider.json, rename it, and fill it in from your provider's API documentation. {domain} and {company} are replaced with the lead's domain and name. Your key is never written here: put it in a Windows user variable (setx NAME value) and write only the variable's NAME below.",
  "key_env": "MY_PROVIDER_API_KEY",
  "request": {
    "method": "GET",
    "url": "https://api.example.com/v1/domain-emails",
    "query": {"domain": "{domain}"},
    "auth": {"in": "header", "name": "Authorization", "prefix": "Bearer "}
  },
  "response": {"list": "data.emails", "email": "email", "kind": "type", "first": "first_name", "last": "last_name", "title": "job_title", "confidence": "score"},
  "response_fields": {
    "phone": {"list": "data.phones", "value": "number", "confidence": "confidence", "identity_domain": "domain", "identity_company": "company", "source_url": "source_url"},
    "person_identity": {"list": "data.people", "fields": {"name": "full_name", "title": "current_title", "current_company": "current_company", "profile_url": "profile_url", "domain": "company_domain"}, "confidence": "confidence", "identity_score": "identity_score", "source_url": "profile_url"},
    "firmographics": {"list": "data.company", "fields": {"company": "name", "domain": "domain", "industry": "industry", "business_type": "business_type", "employee_count": "employee_count", "employee_range": "employee_range", "annual_revenue": "annual_revenue", "revenue_range": "revenue_range", "headquarters": "headquarters", "city": "city", "state": "state", "country": "country", "description": "description", "legal_form": "legal_form", "founded_year": "founded_year"}, "confidence": "confidence", "identity_score": "identity_score", "source_url": "source_url"}
  },
  "credits": "Say here what one call costs, so the next person knows.",
  "cost_per_call": null,
  "cost_currency": "USD"
}
